{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/membraince-hook.sh\" session-start",
            "timeout": 20,
            "statusMessage": "Recalling memories"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/membraince-hook.sh\" queue",
            "timeout": 5
          },
          {
            "type": "mcp_tool",
            "server": "plugin:membraince:membraince",
            "tool": "recall",
            "input": {
              "query": "${prompt}",
              "limit": 5,
              "quiet": true
            },
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/membraince-hook.sh\" save",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/membraince-hook.sh\" save",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
